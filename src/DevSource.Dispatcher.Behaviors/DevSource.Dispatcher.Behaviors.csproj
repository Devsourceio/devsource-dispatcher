<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not packed on its own: the DevSource.Dispatcher package ships this assembly next to the Engine. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DevSource.Dispatcher.Behaviors</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevSource.Dispatcher\DevSource.Dispatcher.csproj" AdditionalProperties="GeneratePackageOnBuild=false" />
    <ProjectReference Include="..\DevSource.Dispatcher.Engine\DevSource.Dispatcher.Engine.csproj" />
  </ItemGroup>

</Project>
